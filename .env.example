PORT=1563

# Compte admin global (dashboard, editeur de cartes).
#
# Rien a faire : si aucune des variables ci-dessous n'est definie, un compte
# admin complet (email + mot de passe) est genere automatiquement au premier
# "npm start", persiste dans ce fichier .env, et affiche a chaque demarrage
# dans le terminal (section "Admin - email" / "Admin - mot de passe").
#
# Pour choisir toi-meme un mot de passe (pratique en dev) : renseigne
# ADMIN_EMAIL + ADMIN_PASSWORD en clair, le hash est recalcule automatiquement
# a chaque demarrage.
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=

# Pour une config "production" ou le mot de passe en clair ne doit jamais
# etre lu par le serveur, genere le hash toi-meme et ne renseigne QUE les
# 3 variables suivantes (le mot de passe ne sera alors plus jamais affiche) :
# node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('ADMIN_PASSWORD_SALT='+s);console.log('ADMIN_PASSWORD_HASH='+c.scryptSync('TON_MOT_DE_PASSE',s,64).toString('hex'))"
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD_SALT=
# ADMIN_PASSWORD_HASH=

# Notifications push (genere une seule fois avec: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

